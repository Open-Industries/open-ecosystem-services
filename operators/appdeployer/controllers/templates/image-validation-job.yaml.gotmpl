apiVersion: batch/v1
kind: Job
metadata:
  name: {{ .ImageCheckJobName }}
  namespace: {{ .Namespace }}
  labels:
    app.kubernetes.io/name: appdeployer
    app.kubernetes.io/instance: {{ .Name }}
spec:
  backoffLimit: 3
  ttlSecondsAfterFinished: 86400
  template:
    spec:
      restartPolicy: Never
      containers:
        - name: inspect
          image: quay.io/skopeo/stable:v1.18
          command: [/bin/sh, -c]
          args:
            - >-
              skopeo inspect --tls-verify={{ .RegistryTLSVerify }}
              --authfile /registry/.dockerconfigjson
              docker://{{ .ImageRef }}
          volumeMounts:
            - name: registry-auth
              mountPath: /registry
              readOnly: true
      volumes:
        - name: registry-auth
          secret:
            secretName: {{ .RegistrySecret }}
